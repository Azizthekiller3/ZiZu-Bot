# ════════════════════════════════════════════════════════════════
#  ZiZubot™ — Configuration Template
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ════════════════════════════════════════════════════════════════


# ── REQUIRED ─────────────────────────────────────────────────────

# Telegram API credentials — get from https://my.telegram.org
API_ID=
API_HASH=

# Bot token — get from @BotFather on Telegram
BOT_TOKEN=

# Your Telegram user ID(s) — space-separated if multiple admins
# Get your ID by messaging @userinfobot
ADMINS=

# MongoDB Atlas connection string
# Free cluster: https://www.mongodb.com/atlas/database
# Format: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?appName=Cluster0
DATABASE_URI=

# Telegram channel ID where the bot sends logs
# Must be a supergroup/channel and the bot must be admin there
# Format: -100XXXXXXXXXX
LOG_CHANNEL=


# ── DEPLOYMENT ───────────────────────────────────────────────────

# Your public HTTPS URL — used for the keep-alive self-ping to prevent
# Koyeb / Render / Railway free-tier from sleeping.
# On Koyeb: set this to your service public URL, e.g.:
#   https://your-app-name-xxxx.koyeb.app
# Leave empty to disable keep-alive (bot will sleep on free-tier hosts)
PUBLIC_URL=

# Pyrogram session name (optional — change if running multiple bots)
SESSION=ZiZuBot_Session


# ── RECOMMENDED ──────────────────────────────────────────────────

# Channel(s) to auto-index files from — space-separated IDs
# The bot must be admin in each channel
# CHANNELS=-1001234567890 -1009876543210
CHANNELS=

# Force-subscribe channel — users must join before getting files
# Leave empty to disable
# AUTH_CHANNEL=-1001234567890
AUTH_CHANNEL=

# Your support group username (without @)
SUPPORT_CHAT=ZiZuBot_support

# MongoDB database name
DATABASE_NAME=ZiZuBot

# MongoDB collection name for indexed files
COLLECTION_NAME=Telegram_files

# Channel for receiving index requests from non-admins
# Defaults to LOG_CHANNEL if not set
# INDEX_REQ_CHANNEL=-1001234567890
INDEX_REQ_CHANNEL=

# Channel(s) for file-store feature — space-separated IDs
# FILE_STORE_CHANNEL=-1001234567890
FILE_STORE_CHANNEL=


# ── FEATURE FLAGS ─────────────────────────────────────────────────

# Send files to user PM (True) instead of directly in the group (False)
P_TTI_SHOW_OFF=True

# Show IMDB info card on search results
IMDB=False

# Use single-column file buttons
SINGLE_BUTTON=True

# Suggest spelling corrections when no results found
SPELL_CHECK_REPLY=True

# Enable Telegram forward-protection on sent files
PROTECT_CONTENT=False

# Send welcome video to new group members
MELCOW_NEW_USERS=True

# Allow anyone (not just group members) to use file-store links
PUBLIC_FILE_STORE=False

# Show full IMDB plot description
LONG_IMDB_DESCRIPTION=False

# Search within file captions in addition to filenames
USE_CAPTION_FILTER=False

# Inline query result cache time in seconds
CACHE_TIME=300

# Maximum cast/crew list items to show (leave empty for full list)
MAX_LIST_ELM=


# ── AUTO-APPROVE ─────────────────────────────────────────────────

# Automatically approve channel/group join requests (ON or OFF)
AUTO_APPROVE=ON

# Send a welcome DM when auto-approving a join request (ON or OFF)
WELCOME_DM=OFF


# ── CAPTIONS & TEMPLATES ─────────────────────────────────────────

# File caption template — available: {file_name} {file_size} {file_caption}
# CUSTOM_FILE_CAPTION=📁 <b>{file_name}</b>
💾 {file_size}

# Batch file caption template
# BATCH_FILE_CAPTION=📂 <em>{file_name}</em>
♻ {file_size}

# IMDB result template — available: {title} {year} {rating} {genres} {url} {plot} etc.
# IMDB_TEMPLATE=🏷 <b>{title}</b> ({year})
⭐ {rating}/10
🎭 {genres}
